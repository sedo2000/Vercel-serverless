{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "BOT_TOKEN": "@bot_token",
    "ADMIN_ID": "@admin_id",
    "CHANNEL_ID": "@channel_id"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
